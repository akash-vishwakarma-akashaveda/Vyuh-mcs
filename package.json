    "axios": "^1.6.8",
    "cesium": "^1.144.0",
    "clsx": "^2.1.0",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.0.0",
    "framer-motion": "^11.0.24",
    "globe.gl": "^2.46.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.3",
    "tailwind-merge": "^2.2.2",
