{
  "name": "vyuh-mcs-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "esbuild src/checks/run.ts --bundle --platform=node --format=cjs --define:import.meta.env={} --outfile=node_modules/.tmp/check.cjs --log-level=error && node node_modules/.tmp/check.cjs",
    "gen:light": "node scripts/gen-light.cjs",
    "gen:dictionary": "esbuild scripts/gen-dictionary.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/gen-dictionary.cjs --log-level=error && node node_modules/.tmp/gen-dictionary.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-router": "^1.22.0",
